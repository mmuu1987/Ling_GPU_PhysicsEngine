#pragma kernel ClearPendingDamage
#pragma kernel SimulateCombatAndAccumulateDamage

#include "AgentDataCommon_Stage6.hlsl"

void StoreAgent(uint index, AgentData agent)
{
    agentBuffer[index] = agent;
    agentPositionBuffer[index] = agent.position.xz;
}

[numthreads(64, 1, 1)]
void ClearPendingDamage(uint3 id : SV_DispatchThreadID)
{
    if (!IsValidAgentIndex(id.x))
        return;

    pendingDamageBuffer[id.x] = 0;
}

[numthreads(64, 1, 1)]
void SimulateCombatAndAccumulateDamage(uint3 id : SV_DispatchThreadID)
{
    if (!IsValidAgentIndex(id.x))
        return;

    AgentData agent = agentBuffer[id.x];
    float dt = SafeDt();

    if (battleStarted == 0)
    {
        targetAgentIndexBuffer[id.x] = -1;
        attackCooldownBuffer[id.x] = 0.0;
        agent.velocity = 0.0;

        if (hpBuffer[id.x] <= 0)
            SetAgentState(agent, STATE_DEAD);
        else
            SetAgentState(agent, STATE_IDLE);

        StoreAgent(id.x, agent);
        return;
    }

    int damage = pendingDamageReadBuffer[id.x];
    if (damage > 0 && hpBuffer[id.x] > 0)
        hpBuffer[id.x] = max(0, hpBuffer[id.x] - damage);

    if (hpBuffer[id.x] <= 0)
    {
        SetAgentState(agent, STATE_DEAD);
        agent.velocity = 0.0;
        targetAgentIndexBuffer[id.x] = -1;
        attackCooldownBuffer[id.x] = 0.0;
        StoreAgent(id.x, agent);
        return;
    }

    float cooldown = max(0.0, attackCooldownBuffer[id.x] - dt);
    int targetIndex = targetAgentIndexBuffer[id.x];
    float searchRadius = GetTargetAcquireRadius(id.x);
    bool needsTargetSearch = !CurrentTargetIsValid(id.x, agent, targetIndex);
    NeighborhoodQueryResult neighborhood = QueryCombatNeighborhood(id.x, agent, searchRadius, needsTargetSearch);

    if (needsTargetSearch)
        targetIndex = neighborhood.nearestEnemyIndex;

    int nextState = STATE_MOVE;
    float2 desiredDirection = 0.0;
    bool isDefender = IsDefender(id.x);
    bool defenderHoldingPosition = isDefender && defenderMovementMode == DEFENDER_MODE_HOLD_POSITION;

    if (targetIndex >= 0 && IsAliveIndexRw((uint)targetIndex))
    {
        float2 toTarget = agentPositionReadBuffer[(uint)targetIndex] - agent.position.xz;
        float distSqr = dot(toTarget, toTarget);
        float activeAttackRange = GetAttackRange(id.x);
        float attackRangeSqr = activeAttackRange * activeAttackRange;

        if (isDefender && defenderMovementMode != DEFENDER_MODE_FLOW_FIELD && !defenderHoldingPosition)
        {
            float2 fromHome = agent.position.xz - homePositionReadBuffer[id.x].xz;
            float chaseSqr = defenderMaxChaseDistance * defenderMaxChaseDistance;
            if (dot(fromHome, fromHome) > chaseSqr)
                targetIndex = -1;
        }

        if (targetIndex >= 0)
        {
            if (distSqr <= attackRangeSqr)
            {
                FaceDirection(agent, toTarget);
                nextState = STATE_ATTACK;
                if (cooldown <= 0.0)
                {
                    int ignored;
                    InterlockedAdd(pendingDamageBuffer[(uint)targetIndex], max(1, GetAttackDamage(id.x)), ignored);
                    cooldown = GetAttackInterval(id.x);
                }
            }
            else
            {
                nextState = STATE_ENGAGE;
                if (!defenderHoldingPosition)
                    desiredDirection = normalize(toTarget);
            }
        }
    }

    if (targetIndex < 0)
    {
        if (isDefender)
        {
            if (defenderHoldingPosition)
            {
                nextState = STATE_IDLE;
            }
            else if (defenderMovementMode == DEFENDER_MODE_FLOW_FIELD)
            {
                desiredDirection = SampleDefenderFlowDirection(agent.position);
                nextState = dot(desiredDirection, desiredDirection) > 0.0001 ? STATE_MOVE : STATE_IDLE;
            }
            else
            {
                float2 toHome = homePositionReadBuffer[id.x].xz - agent.position.xz;
                if (dot(toHome, toHome) > defenderGuardRadius * defenderGuardRadius)
                {
                    desiredDirection = normalize(toHome);
                    nextState = STATE_MOVE;
                }
                else
                {
                    nextState = STATE_IDLE;
                }
            }
        }
        else
        {
            desiredDirection = SampleFlowDirection(agent.position);
            nextState = dot(desiredDirection, desiredDirection) > 0.0001 ? STATE_MOVE : STATE_IDLE;
        }
    }

    if (nextState != agent.currentState)
        agent.currentAnimationTime = 0.0;

    agent.currentState = nextState;
    attackCooldownBuffer[id.x] = cooldown;
    targetAgentIndexBuffer[id.x] = targetIndex;

    if (defenderHoldingPosition)
    {
        agent.velocity = 0.0;
        StoreAgent(id.x, agent);
        return;
    }

    agent.velocity.xz += neighborhood.separation * GetSeparationStrength(id.x) * dt;
    agent.velocity *= saturate(1.0 - GetVelocityDamping(id.x) * dt);

    if (agent.currentState == STATE_ATTACK)
    {
        agent.velocity.xz *= saturate(1.0 - 12.0 * dt);
    }
    else if (dot(desiredDirection, desiredDirection) > 0.0001)
    {
        float steer = saturate((agent.currentState == STATE_ENGAGE ? 10.0 : flowFieldResponsiveness) * max(flowFieldWeight, 0.2) * dt);
        agent.velocity.xz = lerp(agent.velocity.xz, desiredDirection * GetMaxSpeed(id.x), steer);
        FaceDirection(agent, desiredDirection);
    }

    agent.velocity = ClampVelocity(id.x, agent.velocity);
    agent.position += agent.velocity * dt;
    ApplyBounds(agent);

    if (dot(agent.velocity.xz, agent.velocity.xz) > 0.0001 && agent.currentState != STATE_ATTACK)
        FaceDirection(agent, agent.velocity.xz);

    StoreAgent(id.x, agent);
}
