#pragma kernel ClearRuntimeFlowResources
#pragma kernel BuildRuntimeFlowTargetDensity
#pragma kernel SelectRuntimeFlowTargets
#pragma kernel GenerateRuntimeFlowField

#include "../../Core/Shaders/AgentDataCommon.hlsl"

// These four kernels rebuild ONE team's flow field per dispatch, the team named by the
// flowTeamId uniform. They used to exist twice over - Attacker* and Defender* copies of
// every kernel, reading their own uniforms and their own buffers - which capped the
// engine at two navigating teams. Rebuilds are already staggered across teams, so only
// one team rebuilds on any given frame and one dispatch per team costs nothing extra.

// Team 0 keeps the old attacker red and team 1 the old defender blue, so the preview
// overlay reads exactly as before for a two-army battle. Further teams get distinct hues.
static const float3 kTeamFlowPreviewPalette[8] =
{
    float3(0.85, 0.18, 0.08),
    float3(0.08, 0.42, 0.85),
    float3(0.18, 0.75, 0.24),
    float3(0.86, 0.72, 0.10),
    float3(0.66, 0.24, 0.82),
    float3(0.12, 0.74, 0.76),
    float3(0.90, 0.45, 0.12),
    float3(0.60, 0.60, 0.62)
};

uint FlowTeamSlot()
{
    return (uint)max(0, flowTeamId);
}

uint FlowDensityIndex(uint cellIndex)
{
    return FlowFieldTeamCellIndex(flowTeamId, cellIndex);
}

uint FlowStatsIndex(uint slot)
{
    return FlowTeamSlot() * FLOW_STATS_PER_TEAM + slot;
}

uint FlowTargetIndex(uint sector)
{
    return FlowTeamSlot() * FLOW_TARGETS_PER_TEAM + sector;
}

float3 FlowTeamPreviewTint()
{
    return kTeamFlowPreviewPalette[FlowTeamSlot() & 7u];
}

[numthreads(64, 1, 1)]
void ClearRuntimeFlowResources(uint3 id : SV_DispatchThreadID)
{
    uint cellCount = FlowFieldCellCount();
    if (id.x < cellCount)
        runtimeFlowTargetDensity[FlowDensityIndex(id.x)] = 0;

    if (id.x == 0)
    {
        runtimeFlowStats[FlowStatsIndex(0u)] = 0;
        runtimeFlowStats[FlowStatsIndex(1u)] = 0;
        runtimeFlowStats[FlowStatsIndex(2u)] = 0;
        runtimeFlowStats[FlowStatsIndex(3u)] = 0;
    }

    if (id.x < FLOW_TARGETS_PER_TEAM)
    {
        runtimeFlowTargets[FlowTargetIndex(id.x)] = 0.0;
    }
}

[numthreads(64, 1, 1)]
void BuildRuntimeFlowTargetDensity(uint3 id : SV_DispatchThreadID)
{
    TeamFlowParams params = GetTeamFlowParams(flowTeamId);
    if (params.modes.z == 0 || enableTwoTeamCombat == 0 || battleStarted == 0)
        return;

    uint count;
    uint stride;
    agentBuffer.GetDimensions(count, stride);
    // Team identity comes from teamIdReadBuffer only: a team's flow field steers it toward
    // every agent that is NOT on that team.
    if (id.x >= count || teamIdReadBuffer[id.x] == flowTeamId || !IsAliveIndex(id.x))
        return;

    float2 position = agentPositionReadBuffer[id.x];
    int2 cell = PositionXzToFlowFieldCell(position);
    uint cellIndex = FlowFieldCellToIndex(cell);
    uint ignoredDensity;
    InterlockedAdd(runtimeFlowTargetDensity[FlowDensityIndex(cellIndex)], 1u, ignoredDensity);

    // [1]/[2] accumulate positions at 1m precision (int32-safe up to ~3M agents at
    // +-640m) for the endgame global-centroid fallback in GenerateRuntimeFlowField.
    int ignoredStats;
    InterlockedAdd(runtimeFlowStats[FlowStatsIndex(0u)], 1, ignoredStats);
    InterlockedAdd(runtimeFlowStats[FlowStatsIndex(1u)], (int)round(position.x), ignoredStats);
    InterlockedAdd(runtimeFlowStats[FlowStatsIndex(2u)], (int)round(position.y), ignoredStats);
}

// Parallel per-sector target selection: one 64-thread group per sector strides the
// sector's cells, then a groupshared tree reduction. Replaces a single-thread scan
// of the whole grid (up to 8 x 256 x 256 serial iterations = a visible frame spike
// on every dynamic rebuild). The endgame fallback needs a view across ALL sectors,
// which no longer exists inside this per-sector kernel; it moved into
// GenerateRuntimeFlowField (stats[3] == 0 there means "no sector met the bar").
groupshared uint gsSectorDensitySum[64];
groupshared float2 gsSectorPositionSum[64];

[numthreads(64, 1, 1)]
void SelectRuntimeFlowTargets(uint3 groupId : SV_GroupID, uint groupThreadIndex : SV_GroupIndex)
{
    TeamFlowParams params = GetTeamFlowParams(flowTeamId);
    bool active = params.modes.z != 0 && enableTwoTeamCombat != 0 && battleStarted != 0
        && runtimeFlowStats[FlowStatsIndex(0u)] > 0;

    uint sectorCount = (uint)clamp((int)params.target.w, 1, FLOW_TARGETS_PER_TEAM);
    uint sectorIndex = groupId.x;
    active = active && sectorIndex < sectorCount;

    uint localDensity = 0u;
    float2 localPositionSum = 0.0;
    if (active)
    {
        int minZ = (int)((sectorIndex * (uint)flowFieldResolution.y) / sectorCount);
        int maxZ = (int)(((sectorIndex + 1u) * (uint)flowFieldResolution.y) / sectorCount);
        uint rowWidth = (uint)flowFieldResolution.x;
        uint cellsInSector = (uint)max(0, maxZ - minZ) * rowWidth;
        for (uint i = groupThreadIndex; i < cellsInSector; i += 64u)
        {
            int2 cell = int2((int)(i % rowWidth), minZ + (int)(i / rowWidth));
            uint density = runtimeFlowTargetDensity[FlowDensityIndex(FlowFieldCellToIndex(cell))];
            if (density > 0u)
            {
                localDensity += density;
                localPositionSum += FlowFieldCellCenter(cell) * (float)density;
            }
        }
    }

    gsSectorDensitySum[groupThreadIndex] = localDensity;
    gsSectorPositionSum[groupThreadIndex] = localPositionSum;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint stride = 32u; stride > 0u; stride >>= 1u)
    {
        if (groupThreadIndex < stride)
        {
            gsSectorDensitySum[groupThreadIndex] += gsSectorDensitySum[groupThreadIndex + stride];
            gsSectorPositionSum[groupThreadIndex] += gsSectorPositionSum[groupThreadIndex + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    if (groupThreadIndex == 0u && active)
    {
        uint sectorEnemyCount = gsSectorDensitySum[0];
        if (sectorEnemyCount >= (uint)max(1, params.modes.w))
        {
            float2 target = gsSectorPositionSum[0] / max(1.0, (float)sectorEnemyCount);
            runtimeFlowTargets[FlowTargetIndex(sectorIndex)] = float4(target.x, target.y, (float)sectorEnemyCount, 1.0);
            int ignoredTargetCount;
            InterlockedAdd(runtimeFlowStats[FlowStatsIndex(3u)], 1, ignoredTargetCount);
        }
    }
}

[numthreads(64, 1, 1)]
void GenerateRuntimeFlowField(uint3 id : SV_DispatchThreadID)
{
    uint cellCount = FlowFieldCellCount();
    if (id.x >= cellCount)
        return;

    TeamFlowParams params = GetTeamFlowParams(flowTeamId);
    uint writeIndex = FlowDensityIndex(id.x);
    int targetMode = params.modes.x;
    float stopRadiusSetting = params.target.z;
    int minEnemiesPerTarget = params.modes.w;

    bool useConfiguredTarget = targetMode != FLOW_TARGET_NONE;
    if (!useConfiguredTarget && (params.modes.z == 0 || enableTwoTeamCombat == 0 || battleStarted == 0))
    {
        // No target and no active dynamic targeting: clear the field explicitly so a
        // removed target cannot leave stale directions behind (agents would otherwise
        // keep marching toward a ghost target forever).
        flowFieldDirections[writeIndex] = 0.0;
        if (flowPreviewEnabled != 0)
        {
            int px = (int)(id.x % (uint)flowFieldResolution.x);
            int pz = (int)(id.x / (uint)flowFieldResolution.x);
            runtimeFlowPreviewTexture[int2(px, pz)] = float4(0.03, 0.03, 0.03, 1.0);
        }
        return;
    }

    int x = (int)(id.x % (uint)flowFieldResolution.x);
    int z = (int)(id.x / (uint)flowFieldResolution.x);
    int2 cell = int2(x, z);
    float2 cellCenter = FlowFieldCellCenter(cell);

    if (useConfiguredTarget)
    {
        float2 offsetToConfiguredTarget = ConfiguredFlowTargetOffset(cellCenter, targetMode, params.target, params.area);
        float distSqrToConfiguredTarget = dot(offsetToConfiguredTarget, offsetToConfiguredTarget);
        float stopRadius = max(max(0.0, stopRadiusSetting), flowFieldCellSize * 0.75);
        float2 configuredDirection = (distSqrToConfiguredTarget <= stopRadius * stopRadius || distSqrToConfiguredTarget <= 0.0001)
            ? 0.0
            : StaticObstacleAwareDirection(cellCenter, cellCenter + offsetToConfiguredTarget, flowFieldCellSize * 0.5);

        flowFieldDirections[writeIndex] = configuredDirection;
        if (flowPreviewEnabled != 0)
            runtimeFlowPreviewTexture[int2(x, z)] = float4(FlowDirectionToPreviewColor(configuredDirection), 1.0);
        return;
    }

    int aliveEnemyCount = runtimeFlowStats[FlowStatsIndex(0u)];
    if (aliveEnemyCount <= 0)
    {
        flowFieldDirections[writeIndex] = 0.0;
        if (flowPreviewEnabled != 0)
            runtimeFlowPreviewTexture[int2(x, z)] = float4(0.03, 0.03, 0.03, 1.0);
        return;
    }

    int targetCount = clamp(runtimeFlowStats[FlowStatsIndex(3u)], 0, FLOW_TARGETS_PER_TEAM);
    uint sectorCount = (uint)clamp((int)params.target.w, 1, FLOW_TARGETS_PER_TEAM);
    uint currentSectorU = min(((uint)z * sectorCount) / max(1u, (uint)flowFieldResolution.y), sectorCount - 1u);
    int currentSector = (int)currentSectorU;
    int sectorCountInt = (int)sectorCount;
    int selectedSector = currentSector;
    float4 selectedTarget;

    if (targetCount <= 0)
    {
        // Endgame fallback (moved from the Select kernel when it went parallel):
        // survivors below every sector threshold must still be hunted down or a
        // 200k-vs-35 battle never concludes. Steer every cell at the global centroid
        // accumulated in stats[1]/[2] (1m precision position sums).
        float aliveCount = max(1.0, (float)aliveEnemyCount);
        selectedTarget = float4(
            (float)runtimeFlowStats[FlowStatsIndex(1u)] / aliveCount,
            (float)runtimeFlowStats[FlowStatsIndex(2u)] / aliveCount,
            aliveCount,
            1.0);
    }
    else
    {
        selectedSector = -1;
        if (runtimeFlowTargets[FlowTargetIndex((uint)currentSector)].w > 0.0)
        {
            selectedSector = currentSector;
        }
        else
        {
            for (int radius = 1; radius < FLOW_TARGETS_PER_TEAM && selectedSector < 0; radius++)
            {
                int lower = currentSector - radius;
                int upper = currentSector + radius;
                if (lower >= 0 && runtimeFlowTargets[FlowTargetIndex((uint)lower)].w > 0.0)
                    selectedSector = lower;
                if (selectedSector < 0 && upper < sectorCountInt && runtimeFlowTargets[FlowTargetIndex((uint)upper)].w > 0.0)
                    selectedSector = upper;
            }
        }

        if (selectedSector < 0)
        {
            flowFieldDirections[writeIndex] = 0.0;
            if (flowPreviewEnabled != 0)
                runtimeFlowPreviewTexture[int2(x, z)] = float4(0.03, 0.03, 0.03, 1.0);
            return;
        }

        selectedTarget = runtimeFlowTargets[FlowTargetIndex((uint)selectedSector)];
    }
    int sectorMinZ = (int)(((uint)selectedSector * (uint)flowFieldResolution.y) / sectorCount);
    int sectorMaxZ = (int)((((uint)selectedSector + 1u) * (uint)flowFieldResolution.y) / sectorCount);
    float targetX = selectedTarget.x;
    // Pure-X steering strands agents whose Z lane is enemy-free at the centroid X
    // line forever; pull each lane 35% toward the sector's density centroid Z so lanes
    // converge onto the live cluster while the front still stays spread.
    float clampedOwnZ = clamp(cellCenter.y, FlowFieldCellCenter(int2(x, sectorMinZ)).y, FlowFieldCellCenter(int2(x, max(sectorMinZ, sectorMaxZ - 1))).y);
    float targetZ = lerp(clampedOwnZ, selectedTarget.y, 0.35);
    float2 target = float2(targetX, targetZ);
    float targetWeight = selectedTarget.z;

    float2 offset = target - cellCenter;
    float distSqr = dot(offset, offset);
    float stopRadius = max(max(0.0, stopRadiusSetting), flowFieldCellSize * 0.75);
    float2 direction = (distSqr <= stopRadius * stopRadius || distSqr <= 0.0001)
        ? 0.0
        : StaticObstacleAwareDirection(cellCenter, target, flowFieldCellSize * 0.5);

    flowFieldDirections[writeIndex] = direction;

    float lengthSqr = dot(direction, direction);
    float density01 = saturate(targetWeight / max(1.0, (float)minEnemiesPerTarget * 4.0));
    float3 color = 0.03;

    if (runtimeFlowPreviewMode == 0)
    {
        color = FlowDirectionToPreviewColor(direction);
    }
    else
    {
        color = lerp(float3(0.08, 0.08, 0.08), FlowTeamPreviewTint(), density01);
        if (lengthSqr > 0.0001)
            color = lerp(color, float3(1.0, 0.86, 0.12), saturate(density01 * 0.75));
    }

    if (flowPreviewEnabled != 0)
        runtimeFlowPreviewTexture[int2(x, z)] = float4(color, 1.0);
}
