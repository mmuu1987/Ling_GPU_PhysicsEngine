#pragma kernel ClearRuntimeFlowResources
#pragma kernel BuildRuntimeTargetDensity
#pragma kernel SelectRuntimeFlowTargets
#pragma kernel GenerateRuntimeFlowField

#include "../../Core/Shaders/AgentDataCommon.hlsl"

[numthreads(64, 1, 1)]
void ClearRuntimeFlowResources(uint3 id : SV_DispatchThreadID)
{
    uint cellCount = FlowFieldCellCount();
    uint baseOffset = GetTeamFlowFieldOffset(activeTeamIndex);

    if (id.x < cellCount)
        runtimeTargetDensity[baseOffset + id.x] = 0;

    if (id.x == 0)
    {
        uint statsOffset = GetTeamFlowStatsOffset(activeTeamIndex);
        runtimeFlowStats[statsOffset + 0] = 0;
        runtimeFlowStats[statsOffset + 1] = 0;
        runtimeFlowStats[statsOffset + 2] = 0;
        runtimeFlowStats[statsOffset + 3] = 0;
    }

    if (id.x < 8)
    {
        uint targetsOffset = GetTeamFlowTargetsOffset(activeTeamIndex);
        runtimeFlowTargets[targetsOffset + id.x] = 0.0;
    }
}

[numthreads(64, 1, 1)]
void BuildRuntimeTargetDensity(uint3 id : SV_DispatchThreadID)
{
    if (runtimeDynamicFlowEnabled == 0 || enableTwoTeamCombat == 0 || battleStarted == 0)
        return;

    uint count;
    uint stride;
    agentBuffer.GetDimensions(count, stride);
    if (id.x >= count || teamIdReadBuffer[id.x] == activeTeamIndex || !IsAliveIndex(id.x))
        return;

    float2 position = agentPositionReadBuffer[id.x];
    int2 cell = PositionXzToFlowFieldCell(position);
    uint cellIndex = FlowFieldCellToIndex(cell);
    uint baseOffset = GetTeamFlowFieldOffset(activeTeamIndex);

    uint ignoredDensity;
    InterlockedAdd(runtimeTargetDensity[baseOffset + cellIndex], 1u, ignoredDensity);

    uint statsOffset = GetTeamFlowStatsOffset(activeTeamIndex);
    int ignoredStats;
    InterlockedAdd(runtimeFlowStats[statsOffset + 0], 1, ignoredStats);
    InterlockedAdd(runtimeFlowStats[statsOffset + 1], (int)round(position.x), ignoredStats);
    InterlockedAdd(runtimeFlowStats[statsOffset + 2], (int)round(position.y), ignoredStats);
}

[numthreads(8, 1, 1)]
void SelectRuntimeFlowTargets(uint3 id : SV_DispatchThreadID)
{
    if (runtimeDynamicFlowEnabled == 0 || enableTwoTeamCombat == 0 || battleStarted == 0)
        return;

    uint sectorIndex = id.x;
    if (sectorIndex >= (uint)dynamicFlowSectorCount)
        return;

    uint statsOffset = GetTeamFlowStatsOffset(activeTeamIndex);
    int totalTargets = runtimeFlowStats[statsOffset + 0];
    if (totalTargets < dynamicFlowMinDefendersPerTarget)
    {
        uint targetsOffset = GetTeamFlowTargetsOffset(activeTeamIndex);
        runtimeFlowTargets[targetsOffset + sectorIndex] = float4(0, 0, 0, 0);
        return;
    }

    float angleStep = 6.283185307 / (float)dynamicFlowSectorCount;
    float sectorAngle = angleStep * (float)sectorIndex;
    float2 sectorDir = float2(cos(sectorAngle), sin(sectorAngle));

    float2 centroid = float2(
        (float)runtimeFlowStats[statsOffset + 1] / max(1.0, (float)totalTargets),
        (float)runtimeFlowStats[statsOffset + 2] / max(1.0, (float)totalTargets)
    );

    uint baseOffset = GetTeamFlowFieldOffset(activeTeamIndex);
    int maxDensity = 0;
    float2 maxDensityPos = centroid;

    for (int cy = 0; cy < flowFieldResolution.y; cy++)
    {
        for (int cx = 0; cx < flowFieldResolution.x; cx++)
        {
            uint cellIndex = (uint)cy * (uint)flowFieldResolution.x + (uint)cx;
            int density = (int)runtimeTargetDensity[baseOffset + cellIndex];
            if (density <= 0)
                continue;

            float2 cellWorldPos = FlowFieldCellToWorldCenter(int2(cx, cy));
            float2 fromCentroid = cellWorldPos - centroid;
            float projection = dot(normalize(fromCentroid + float2(0.001, 0.001)), sectorDir);

            if (projection > 0.5 && density > maxDensity)
            {
                maxDensity = density;
                maxDensityPos = cellWorldPos;
            }
        }
    }

    uint targetsOffset = GetTeamFlowTargetsOffset(activeTeamIndex);
    runtimeFlowTargets[targetsOffset + sectorIndex] = float4(maxDensityPos.x, maxDensityPos.y, (float)maxDensity, 0.0);
}

[numthreads(8, 8, 1)]
void GenerateRuntimeFlowField(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)flowFieldResolution.x || id.y >= (uint)flowFieldResolution.y)
        return;

    if (runtimeDynamicFlowEnabled == 0 || enableTwoTeamCombat == 0 || battleStarted == 0)
        return;

    uint statsOffset = GetTeamFlowStatsOffset(activeTeamIndex);
    int totalTargets = runtimeFlowStats[statsOffset + 0];
    if (totalTargets < dynamicFlowMinDefendersPerTarget)
        return;

    float2 cellWorldPos = FlowFieldCellToWorldCenter(int2(id.x, id.y));
    uint targetsOffset = GetTeamFlowTargetsOffset(activeTeamIndex);
    int bestSector = -1;
    float bestScore = -1e9;

    for (int s = 0; s < dynamicFlowSectorCount && s < 8; s++)
    {
        float4 target = runtimeFlowTargets[targetsOffset + s];
        float2 targetPos = target.xy;
        float density = target.z;

        if (density <= 0.0)
            continue;

        float2 toTarget = targetPos - cellWorldPos;
        float dist = length(toTarget);
        if (dist < 0.01)
            continue;

        float score = density / max(1.0, dist * 0.05);
        if (score > bestScore)
        {
            bestScore = score;
            bestSector = s;
        }
    }

    uint cellIndex = id.y * (uint)flowFieldResolution.x + id.x;
    uint baseOffset = GetTeamFlowFieldOffset(activeTeamIndex);

    if (bestSector >= 0)
    {
        float4 target = runtimeFlowTargets[targetsOffset + bestSector];
        float2 targetPos = target.xy;
        float2 toTarget = targetPos - cellWorldPos;
        float dist = length(toTarget);

        if (dist > 0.01)
            flowFieldDirections[baseOffset + cellIndex] = toTarget / dist;
        else
            flowFieldDirections[baseOffset + cellIndex] = float2(0, 0);
    }
    else
    {
        flowFieldDirections[baseOffset + cellIndex] = float2(0, 0);
    }
}

