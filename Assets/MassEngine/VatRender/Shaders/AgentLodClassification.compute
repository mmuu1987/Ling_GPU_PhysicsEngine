#pragma kernel ClassifyVisibleAgentsForUnitType

#include "../../Core/Shaders/AgentDataCommon.hlsl"

// Dispatched once per registered unit type with classifyUnitTypeIndex set and the
// near/mid/far append buffers of that unit type bound. Each agent belongs to exactly one
// unit type, so animation time is still advanced exactly once per agent per frame.
[numthreads(64, 1, 1)]
void ClassifyVisibleAgentsForUnitType(uint3 id : SV_DispatchThreadID)
{
    uint count;
    uint stride;
    agentBuffer.GetDimensions(count, stride);
    if (id.x >= count)
        return;

    if (unitTypeIndexReadBuffer[id.x] != classifyUnitTypeIndex)
        return;

    AgentData agent = agentBuffer[id.x];

    // Already despawned: its age accumulator is pinned at the despawn ceiling, so the
    // read-modify-write below would store the record unchanged. The same test inside
    // AppendVisibleAgentForUnitType still earns its keep - it catches the ONE frame on
    // which the age reaches the ceiling, and that frame must still be written back.
    if (IsCorpseDespawned(agent))
        return;

    AppendVisibleAgentForUnitType(id.x, agent);
    agentBuffer[id.x] = agent;
}
