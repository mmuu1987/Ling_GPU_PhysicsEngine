#pragma kernel ClearGrid
#pragma kernel BuildSpatialHash

#pragma kernel ClearTeamSpatialStats
#pragma kernel BuildTeamSpatialStats

#include "../../Core/Shaders/AgentDataCommon.hlsl"

[numthreads(64, 1, 1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= gridCellCount)
        return;

    gridCounts[id.x] = 0;
    teamGridCounts[id.x] = 0;
    teamGridCounts[gridCellCount + id.x] = 0;
    if (id.x == 0)
        spatialHashStats[0] = 0;
}

[numthreads(64, 1, 1)]
void BuildSpatialHash(uint3 id : SV_DispatchThreadID)
{
    uint count;
    uint stride;
    agentBuffer.GetDimensions(count, stride);
    if (id.x >= count || !IsAliveIndex(id.x))
        return;

    uint cellIndex = CellToIndex(PositionXzToCell(agentPositionReadBuffer[id.x]));
    uint slot;
    InterlockedAdd(gridCounts[cellIndex], 1, slot);
    if (slot < maxAgentsPerCell)
    {
        gridAgentIndices[cellIndex * maxAgentsPerCell + slot] = id.x;
    }
    else
    {
        int ignored;
        InterlockedAdd(spatialHashStats[0], 1, ignored);
    }

    uint teamSlot = teamIdReadBuffer[id.x] == defenderTeamId ? 1u : 0u;
    uint teamCellIndex = teamSlot * gridCellCount + cellIndex;
    uint teamCellSlot;
    InterlockedAdd(teamGridCounts[teamCellIndex], 1, teamCellSlot);
    if (teamCellSlot < maxAgentsPerCell)
        teamGridAgentIndices[teamCellIndex * maxAgentsPerCell + teamCellSlot] = id.x;
}

[numthreads(64, 1, 1)]
void ClearTeamSpatialStats(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= 16)
        return;

    uint slot = id.x & 7u;
    if (slot == 3u || slot == 4u)
        teamSpatialStats[id.x] = 2147483647;
    else if (slot == 5u || slot == 6u)
        teamSpatialStats[id.x] = -2147483647;
    else
        teamSpatialStats[id.x] = 0;
}

[numthreads(64, 1, 1)]
void BuildTeamSpatialStats(uint3 id : SV_DispatchThreadID)
{
    uint count;
    uint stride;
    agentBuffer.GetDimensions(count, stride);
    if (id.x >= count || !IsAliveIndex(id.x))
        return;

    int teamId = teamIdReadBuffer[id.x];
    if (teamId < 0 || teamId > 1)
        return;

    // One-metre fixed point keeps the sum inside signed 32-bit range for the
    // supported 200k-per-team presets while remaining more precise than the camera.
    int2 position = (int2)round(clamp(agentPositionReadBuffer[id.x], -5000.0, 5000.0));
    uint baseIndex = (uint)(teamId * 8);
    int ignored;
    InterlockedAdd(teamSpatialStats[baseIndex], 1, ignored);
    InterlockedAdd(teamSpatialStats[baseIndex + 1], position.x, ignored);
    InterlockedAdd(teamSpatialStats[baseIndex + 2], position.y, ignored);
    InterlockedMin(teamSpatialStats[baseIndex + 3], position.x, ignored);
    InterlockedMin(teamSpatialStats[baseIndex + 4], position.y, ignored);
    InterlockedMax(teamSpatialStats[baseIndex + 5], position.x, ignored);
    InterlockedMax(teamSpatialStats[baseIndex + 6], position.y, ignored);
    float2 toObservationZone = agentPositionReadBuffer[id.x] - telemetryObservationZone.xy;
    if (telemetryObservationZoneEnabled != 0 &&
        dot(toObservationZone, toObservationZone) <= telemetryObservationZone.z * telemetryObservationZone.z)
    {
        InterlockedAdd(teamSpatialStats[baseIndex + 7], 1, ignored);
    }
}

