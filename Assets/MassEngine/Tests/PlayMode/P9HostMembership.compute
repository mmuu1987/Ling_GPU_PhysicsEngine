#pragma kernel Probe
#include "../../Core/Shaders/LocalPartition.hlsl"
StructuredBuffer<uint> _Queries;
RWStructuredBuffer<uint> _MembershipResult;
[numthreads(64,1,1)]
void Probe(uint3 id:SV_DispatchThreadID) {
 uint count,stride;_Queries.GetDimensions(count,stride);if(id.x>=count)return;
 _MembershipResult[id.x]=LocalPartitionContains(_Queries[id.x])?1:0;
}
