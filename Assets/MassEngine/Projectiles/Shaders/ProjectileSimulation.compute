#pragma kernel SimulateProjectiles
#pragma kernel ClearProjectiles
#pragma kernel CollectActiveProjectiles
#pragma kernel SnapshotProjectilePool
#pragma kernel ApplyProjectileSpawns
#pragma multi_compile __ MASS_TERRAIN_ENABLED
#pragma multi_compile __ MASS_PROJECTILE_UNITS
// Opt-in splash impact effect ring (ProjectileImpactFx). Off = legacy kernel, no extra buffers.
#pragma multi_compile_local __ MASS_PROJECTILE_IMPACT_FX

#include "../../Core/Shaders/AgentDataCommon.hlsl"
#ifdef MASS_TERRAIN_ENABLED
#include "../../Terrain/Shaders/TerrainSurface.hlsl"
#include "../../Terrain/Shaders/TerrainCollision.hlsl"
#endif

#include "ProjectileGeometry.hlsl"

#ifdef MASS_PROJECTILE_UNITS
#include "ProjectileUnitCollision.hlsl"
#endif

#ifdef MASS_PROJECTILE_IMPACT_FX
// Mirrors ProjectileImpactFx.ImpactData (32 bytes). Render-only; never read back by the simulation.
struct ProjectileImpactData
{
    float3 position;
    float radius;
    float time;
    float groundY;
    float2 padding;
};
RWStructuredBuffer<ProjectileImpactData> projectileImpactRing;
RWStructuredBuffer<uint> projectileImpactCounter;
uint projectileImpactCapacity;

void RecordProjectileImpact(float3 impact, float radius)
{
    uint ticket;
    InterlockedAdd(projectileImpactCounter[0], 1u, ticket);
    ProjectileImpactData fx;
    fx.position = impact;
    fx.radius = radius;
    fx.time = currentTime;
#ifdef MASS_TERRAIN_ENABLED
    float4 ground = SampleTerrainSurface(impact.xz);
    fx.groundY = ground.w >= 0.0 ? ground.x : impact.y;
#else
    fx.groundY = 0.0;
#endif
    fx.padding = float2(0.0, 0.0);
    projectileImpactRing[ticket % max(1u, projectileImpactCapacity)] = fx;
}
#endif

// 缓冲区：使用引擎标准命名（与 MassGpuShaderPropertyIds 一致）
RWStructuredBuffer<ProjectileData> projectileBuffer;
// 渲染用：当前活跃槽位索引。只有 CollectActiveProjectiles 写入。
AppendStructuredBuffer<uint> activeProjectileIndices;
// Agent/battle buffers are declared by AgentDataCommon.hlsl.

// 全局参数
// deltaTime 和 currentTime 已在 AgentDataCommon.hlsl 中声明
int maxProjectiles;

// ========================================
// ClearProjectiles Kernel
// 清空所有弹道槽位（初始化用）
// ========================================
[numthreads(64, 1, 1)]
void ClearProjectiles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)maxProjectiles)
        return;

    ProjectileData proj = projectileBuffer[id.x];
    proj.targetAgentIndex = -1;  // 标记为空闲
    projectileBuffer[id.x] = proj;
}

// ========================================
// SimulateProjectiles Kernel
// 弹道物理模拟 + 碰撞检测 + 伤害累积
// ========================================
[numthreads(64, 1, 1)]
void SimulateProjectiles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)maxProjectiles)
        return;

    ProjectileData proj = projectileBuffer[id.x];

    // 跳过空槽位
    if (proj.targetAgentIndex < 0)
        return;

    // ========================================
    // 1. 生命周期检查
    // ========================================
    float age = currentTime - proj.launchTime;
    if (age > proj.maxLifetime)
    {
        proj.targetAgentIndex = -1;  // 超时，销毁弹道
        projectileBuffer[id.x] = proj;
        return;
    }

    // ========================================
    // 2. 目标有效性检查
    // ========================================
    int targetIdx = proj.targetAgentIndex;

    // 边界检查：防止越界访问
    uint agentCount;
    uint agentStride;
    agentPositionReadBuffer.GetDimensions(agentCount, agentStride);

    if (targetIdx < 0 || targetIdx >= (int)agentCount)
    {
        proj.targetAgentIndex = -1;
        projectileBuffer[id.x] = proj;
        return;
    }

#ifndef MASS_PROJECTILE_UNITS
    // Compatibility target-only probe path. Runtime shots are not guided and keep
    // flying if the original target dies or changes team.
    if (hpReadBuffer[targetIdx] <= 0 || teamIdReadBuffer[targetIdx] == proj.sourceTeamId)
    {
        proj.targetAgentIndex = -1;
        projectileBuffer[id.x] = proj;
        return;
    }

#endif
    // ========================================
    // 3. 物理积分（重力 + 速度 + 位置）
    // ========================================
    float3 previousPosition = proj.position;
    // Exact constant-acceleration integration matches the CPU launch solver.
    proj.position += proj.velocity * deltaTime + float3(0, 0.5 * proj.gravity * deltaTime * deltaTime, 0);
    proj.velocity.y += proj.gravity * deltaTime;

    // ========================================
    // 4. 碰撞检测
    // ========================================
#ifdef MASS_PROJECTILE_UNITS
    float nearestT = 2.0;
    int hitIndex = -1;
#ifdef MASS_TERRAIN_ENABLED
    float terrainT;
    if (SweepTerrainSurface(previousPosition, proj.position, terrainT)) nearestT = terrainT;
#else
    // Flat world's floor is y=0; unit spawn height may still be above this plane.
    if (previousPosition.y <= 0.0) nearestT = 0.0;
    else if (proj.position.y <= 0.0)
        nearestT = previousPosition.y / max(1e-8, previousPosition.y - proj.position.y);
#endif
    SweepProjectileUnits(proj, previousPosition, proj.position, agentCount, nearestT, hitIndex);
    if (nearestT <= 1.0)
    {
        proj.position = lerp(previousPosition, proj.position, nearestT);
        if (hitIndex >= 0 && teamIdReadBuffer[hitIndex] != proj.sourceTeamId)
            InterlockedAdd(pendingDamageBuffer[hitIndex], (int)proj.damage);
        // Opt-in area damage at the impact point (unit or ground); no-op when splashRadius == 0.
        ApplyProjectileSplash(proj, proj.position, hitIndex, agentCount);
#ifdef MASS_PROJECTILE_IMPACT_FX
        if (proj.splashRadius > 0.0)
            RecordProjectileImpact(proj.position, proj.splashRadius);
#endif
        // Allies are solid but never receive friendly-fire damage.
        proj.targetAgentIndex = -1;
    }
#else
    float2 targetPos2D = agentPositionReadBuffer[targetIdx];
#ifdef MASS_TERRAIN_ENABLED
    float4 targetSurface = SampleTerrainSurface(targetPos2D);
    if (targetSurface.w < 0.0)
    {
        // Invalid terrain targets do not silently become flat-ground targets.
        proj.targetAgentIndex = -1;
        projectileBuffer[id.x] = proj;
        return;
    }
    float3 targetPos3D = float3(targetPos2D.x, targetSurface.x + 1.0, targetPos2D.y);
    float targetT, terrainT;
    bool targetHit = ProjectileSphereEntry(previousPosition, proj.position - previousPosition,
        targetPos3D, proj.hitRadius, targetT);
    bool terrainHit = SweepTerrainSurface(previousPosition, proj.position, terrainT);
    if (terrainHit && (!targetHit || terrainT <= targetT))
    {
        proj.position = lerp(previousPosition, proj.position, terrainT);
        proj.targetAgentIndex = -1;
        projectileBuffer[id.x] = proj;
        return;
    }
#else
    // Keep the legacy flat-ground variant (including its original closest-point test).
    float3 targetPos3D = float3(targetPos2D.x, 0.0, targetPos2D.y);

    // Swept segment-vs-sphere test prevents fast projectiles from tunnelling through
    // targets when their per-frame travel exceeds the configured hit diameter.
    float3 travel = proj.position - previousPosition;
    float travelLengthSqr = dot(travel, travel);
    float closestT = travelLengthSqr > 0.000001
        ? saturate(dot(targetPos3D - previousPosition, travel) / travelLengthSqr)
        : 0.0;
    float3 closestPoint = previousPosition + travel * closestT;
    float3 diff = closestPoint - targetPos3D;
    float distSqr = dot(diff, diff);
    float hitRadiusSqr = proj.hitRadius * proj.hitRadius;
    bool targetHit = distSqr <= hitRadiusSqr;
#endif

    if (targetHit)
    {
        // ========================================
        // 5. 命中：伤害累积
        // ========================================
        int dmg = (int)proj.damage;
        InterlockedAdd(pendingDamageBuffer[targetIdx], dmg);

        // 销毁弹道
        proj.targetAgentIndex = -1;
    }

#endif
    // 写回弹道数据
    projectileBuffer[id.x] = proj;
}

// ========================================
// CollectActiveProjectiles Kernel
// 压缩活跃槽位供 indirect draw 使用。必须在 SimulateProjectiles 之后调度，
// 否则本帧命中/超时释放的槽位仍会被画出来。
// ========================================
[numthreads(64, 1, 1)]
void CollectActiveProjectiles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)maxProjectiles)
        return;

    // 空闲槽位（targetAgentIndex < 0）不追加：渲染实例数因此始终等于 GPU
    // 真实活跃数，而不是 CPU 侧那份按最大生命周期保守估算的 ActiveCount。
    if (projectileBuffer[id.x].targetAgentIndex < 0)
        return;

    activeProjectileIndices.Append(id.x);
}

// Small ownership snapshot, not a readback of the 64-byte projectile records.
RWStructuredBuffer<int> projectileSlotOccupancy;
StructuredBuffer<ProjectileData> projectileSpawnData;
StructuredBuffer<int> projectileSpawnSlots;
int projectileSpawnCount;

[numthreads(64, 1, 1)]
void SnapshotProjectilePool(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)maxProjectiles) return;
    projectileSlotOccupancy[id.x] = projectileBuffer[id.x].targetAgentIndex >= 0 ? 1 : 0;
}

[numthreads(64, 1, 1)]
void ApplyProjectileSpawns(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)projectileSpawnCount) return;
    int slot = projectileSpawnSlots[id.x];
    if (slot < 0 || slot >= maxProjectiles) return;
    projectileBuffer[slot] = projectileSpawnData[id.x];
}
