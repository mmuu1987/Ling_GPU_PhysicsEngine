/* =====================================================================
   设置 / 帮助 / 兵种库 / 单体模型（Q 版，第 4 阶段）
   面板单位参照 1440 × 810。只显示游戏已有的数据和功能。
   ===================================================================== */

.bh-grow { flex-grow: 1; flex-shrink: 1; }
.pg-wide { width: 100%; margin-left: 0; margin-top: 10px; }

/* ---------- 通用弹窗 ---------- */
.pg-modal { width: 520px; padding: 26px 30px 30px 30px; --frame-fill: #FFFCF4; --frame-radius: 26; --frame-shadow: 0.22; }
.pg-modal .h-page { margin: 0 0 10px 0; font-size: 26px; white-space: normal; }
.pg-modal__body { font-size: 16px; white-space: normal; margin-bottom: 18px; }
.pg-modal .btn { margin-right: 10px; }

/* ---------- 设置 ---------- */
.pg-settings { width: 820px; max-height: 96%; padding: 24px 30px 24px 30px; --frame-fill: #FFFCF4; --frame-radius: 26; --frame-shadow: 0.22; }
.pg-settings .h-page { margin: 2px 0 0 0; }
.pg-settings__body { margin-top: 12px; flex-shrink: 1; }
.pg-settings .vtabs { width: 150px; }
.pg-settings .settings__panes { padding-left: 24px; }
.pg-note { margin: 8px 0 4px 0; }
.pg-srow { height: 46px; }
.pg-srow__hint { margin: -8px 0 2px 0; font-size: 12px; }
.pg-settings .srow__k { width: 130px; }
.pg-settings .srow__v { width: 80px; }
.pg-settings__confirm { margin-top: 18px; }
.pg-settings__foot { margin-top: 14px; padding-top: 12px; border-top-width: 2px; border-color: #EADFCB; }
.pg-status { font-size: 14px; color: var(--c-muted); margin-bottom: 4px; }
.pg-status--pending { color: #1F77C0; -unity-font-style: bold; }
.pg-error { font-size: 13px; color: var(--c-danger); white-space: normal; margin-bottom: 6px; }

/* ---------- 帮助 ---------- */
.pg-help { width: 900px; max-height: 96%; padding: 24px 30px 26px 30px; --frame-fill: #FFFCF4; --frame-radius: 26; --frame-shadow: 0.22; }
.pg-help .h-page { margin: 2px 0 12px 0; }
.pg-help__tabs { margin-bottom: 12px; }
.pg-help__tabs .tseg__item { flex-grow: 1; flex-basis: 0; height: 36px; font-size: 16px; }
.pg-help__scroll { max-height: 330px; flex-shrink: 1; padding: 14px 18px; border-radius: 16px; background-color: #F7F1E4; }
.pg-help__body { font-size: 16px; color: var(--c-ink); white-space: normal; }
.pg-help__note { font-size: 13px; color: var(--c-muted); white-space: normal; margin: 12px 0 14px 0; }
.pg-help__note--bad { color: var(--c-danger); -unity-font-style: bold; }

/* ---------- 单体模型 ---------- */
.pg-zoom { width: 520px; height: 92%; max-height: 640px; padding: 18px 22px 20px 22px; --frame-fill: #FFFCF4; --frame-radius: 26; --frame-shadow: 0.22; }
.pg-zoom__host { flex-grow: 1; margin: 10px 0 10px 0; }
.pg-zoom__name { font-size: 20px; -unity-font-style: bold; color: var(--c-ink); -unity-text-align: middle-center; }
.pg-zoom__line { font-size: 13px; color: var(--c-ink2); -unity-text-align: middle-center; white-space: normal; margin-top: 2px; }
.pg-zoom__line--muted { color: var(--c-muted); font-size: 12px; }

/* 模型预览控件（RenderTexture + 拖动旋转 / 滚轮缩放） */
.upv { flex-grow: 1; border-radius: 16px; background-color: #A4BECA; border-width: 2px; border-color: #7E9BAA; overflow: hidden; }
.upv__view { flex-grow: 1; margin: 6px 6px 0 6px; -unity-background-scale-mode: scale-to-fit; }
.upv__bar { flex-direction: row; align-items: center; height: 30px; margin: 4px 4px 4px 4px; padding: 0 4px 0 10px; border-radius: 12px; background-color: #CCDDE5; }
.upv__status { flex-grow: 1; font-size: 12px; color: var(--c-ink2); -unity-text-align: middle-center; }
.upv__reset { height: 24px; margin: 0; padding: 0 10px; font-size: 12px; }

/* ---------- 兵种库 ---------- */
.lib { padding: 20px 28px 24px 28px; }
.lib-head { align-items: flex-end; margin-bottom: 14px; }
.lib-head__title { margin: 0 0 2px 0; }
.lib-empty { font-size: 18px; color: var(--c-danger); margin-top: 20px; }
.lib-body { flex-grow: 1; flex-shrink: 1; align-items: stretch; }
.lib-left { width: 300px; padding: 14px 10px 14px 14px; margin-right: 16px; }
.lib-count { margin: 0 0 8px 4px; }
.lib-item {
    height: 54px; margin: 0 4px 6px 0; padding: 0 12px; border-radius: 14px; justify-content: center;
    background-color: #F7F1E4; border-width: 2px; border-color: rgba(0, 0, 0, 0);
}
.lib-item:hover { background-color: #FFF1D9; }
.lib-item--on { background-color: #FFFFFF; border-color: #FFA41B; }
.lib-item__name { font-size: 15px; -unity-font-style: bold; color: var(--c-ink); }
.lib-item__id { font-size: 12px; color: var(--c-muted); }
.lib-item--global .lib-item__name { color: #7B63A5; }
.lib-item .lib-chip { margin-left: 6px; }

.lib-card { flex-grow: 1; padding: 16px 20px 18px 20px; }
.lib-card__head { align-items: center; padding-bottom: 10px; border-bottom-width: 2px; border-color: #EADFCB; }
.lib-name { font-size: 26px; -unity-font-style: bold; color: var(--c-ink); }
.lib-chip { margin-left: 6px; font-size: 12px; -unity-font-style: bold; }
.lib-chip--global { color: #7B63A5; border-color: rgba(123, 99, 165, 0.5); background-color: rgba(123, 99, 165, 0.12); }
.lib-chip--official { color: var(--c-muted); background-color: #F3ECDD; }
.lib-chip--dirty { color: #C46F00; border-color: rgba(255, 164, 27, 0.6); background-color: rgba(255, 164, 27, 0.16); }
.lib-card__head .btn--sm { margin-left: 12px; }
.lib-card__content { flex-grow: 1; flex-shrink: 1; margin-top: 10px; align-items: stretch; }
.lib-table { margin-right: 4px; }
.lib-radius { font-size: 15px; -unity-font-style: bold; color: var(--c-ink); white-space: normal; }
.lib-legend { font-size: 12px; color: #854C0C; margin: 4px 0 8px 0; white-space: normal; }
.lib-portrait { width: 214px; margin-left: 14px; }
.lib-group { font-size: 13px; -unity-font-style: bold; color: #E07F00; margin: 10px 0 4px 0; padding-bottom: 4px; border-bottom-width: 2px; border-color: #EADFCB; }
.lib-row { flex-direction: row; align-items: center; height: 46px; padding: 0 6px; border-radius: 12px; }
.lib-row--alt { background-color: #F7F1E4; }
.lib-row__name { width: 124px; font-size: 14px; color: var(--c-ink2); }
.lib-row--custom .lib-row__name { color: var(--c-ink); -unity-font-style: bold; }
.lib-row__slider { flex-grow: 1; flex-shrink: 1; height: 40px; margin: 0 12px; justify-content: center; }
.lib-row__tick { position: absolute; top: 9px; width: 3px; height: 18px; margin-left: -1px; border-radius: 2px; background-color: rgba(59, 63, 76, 0.7); }
.lib-row__official { position: absolute; left: 0; right: 0; bottom: -2px; font-size: 11px; color: var(--c-muted); }
.lib-row__official--right { -unity-text-align: middle-right; }
.lib-slider--global .tslider__fill { background-color: #8E74BE; }
.lib-slider--official .tslider__fill { background-color: #B9B2A4; }
.lib-field { width: 86px; margin: 0; }
.lib-field .unity-base-text-field__input, .lib-field .unity-text-field__input {
    height: 32px; border-radius: 10px; border-width: 2px; border-color: #EADFCB; background-color: #FFFFFF;
    font-size: 14px; color: var(--c-ink); -unity-text-align: middle-right; padding: 0 8px;
}
.lib-field--custom .unity-base-text-field__input, .lib-field--custom .unity-text-field__input { border-color: #B9A6DA; color: #5E4A86; }
.lib-field--changed .unity-base-text-field__input, .lib-field--changed .unity-text-field__input { border-color: #FFB43F; color: #A85E00; }
.lib-row .lib-chip { width: 56px; margin-left: 10px; -unity-text-align: middle-center; }
.lib-row__clear { width: 34px; height: 30px; margin-left: 8px; padding: 0; font-size: 16px; }
.lib-foot { margin-top: 10px; padding-top: 10px; border-top-width: 2px; border-color: #EADFCB; }
.lib-foot__note { font-size: 13px; color: var(--c-muted); white-space: normal; margin-bottom: 10px; }
.lib-foot__note--ok { color: #1F77C0; -unity-font-style: bold; }
.lib-foot__note--bad { color: var(--c-danger); -unity-font-style: bold; }
.lib-foot .btn { margin-left: 8px; }
.lib-save { background-color: #8E74BE; border-color: #6F5A99; color: #FFFFFF; }
.lib-save:hover:enabled { background-color: #9C84CA; border-color: #6F5A99; color: #FFFFFF; }
